<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_03_DNA_reposicion_AS-IS" targetNamespace="http://upao.edu.pe/sii/s12" exporter="bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_03_DNA_reposicion_AS-IS">
    <bpmn:participant id="Part_cli" name="Supermercado (cliente)"/>
    <bpmn:participant id="Part_dna" name="Distribuidora Nacional de Alimentos" processRef="Process_dna"/>
    <bpmn:participant id="Part_prv" name="Proveedor"/>
    <bpmn:messageFlow id="MsgFlow_03_DNA_reposicion_AS-IS_1" name="Pedido" sourceRef="Part_cli" targetRef="s"/>
    <bpmn:messageFlow id="MsgFlow_03_DNA_reposicion_AS-IS_2" name="Orden de compra" sourceRef="t5" targetRef="Part_prv"/>
    <bpmn:messageFlow id="MsgFlow_03_DNA_reposicion_AS-IS_3" name="Mercadería" sourceRef="Part_prv" targetRef="t6"/>
    <bpmn:messageFlow id="MsgFlow_03_DNA_reposicion_AS-IS_4" name="Entrega" sourceRef="t9" targetRef="Part_cli"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_dna" name="Distribuidora Nacional de Alimentos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_dna">
      <bpmn:lane id="Lane_com" name="Área comercial">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_alm" name="Almacén">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cmp" name="Compras">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dis" name="Distribución">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Pedido recibido por teléfono o correo">
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_s"/>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Registrar el pedido en una hoja de cálculo">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_1</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="t2" name="Enviar el pedido por correo al almacén">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_2</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="t3" name="Revisar el correo y el kárdex manual">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_3</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g1" name="¿Hay stock?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_4</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t4" name="Reenviar el requerimiento por correo">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_5</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t5" name="Cotizar y emitir la orden de compra">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_7</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t6" name="Recibir mercadería y anotar en el kárdex">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_8</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g2" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_6</bpmn:incoming>
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_9</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t7" name="Preparar el pedido manualmente">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_10</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t8" name="Despachar y anotar la salida">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_11</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t9" name="Programar el transporte y entregar">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_12</bpmn:incoming>
      <bpmn:outgoing>Flow_03_DNA_reposicion_AS-IS_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="e" name="Pedido entregado con demora">
      <bpmn:incoming>Flow_03_DNA_reposicion_AS-IS_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_1" name="" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_2" name="" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_3" name="" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_4" name="" sourceRef="t3" targetRef="g1"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_5" name="No" sourceRef="g1" targetRef="t4"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_6" name="Sí" sourceRef="g1" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_7" name="" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_8" name="" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_9" name="" sourceRef="t6" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_10" name="" sourceRef="g2" targetRef="t7"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_11" name="" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_12" name="" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="Flow_03_DNA_reposicion_AS-IS_13" name="" sourceRef="t9" targetRef="e"/>
  </bpmn:process>
