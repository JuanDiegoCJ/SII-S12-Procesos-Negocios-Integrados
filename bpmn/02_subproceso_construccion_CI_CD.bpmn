      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="¿Cumple criterios de aceptación?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_02_subproceso_construccion_CI_CD_12</bpmn:incoming>
      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e" name="Incremento listo">
