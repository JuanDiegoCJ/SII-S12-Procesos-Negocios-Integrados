      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Pipeline exitoso?" gatewayDirection="Diverging">
