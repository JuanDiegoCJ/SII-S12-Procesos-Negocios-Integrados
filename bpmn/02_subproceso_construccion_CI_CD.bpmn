      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="¿Cambios aprobados?" gatewayDirection="Diverging">
