  <bpmn:collaboration id="Collab_02_subproceso_construccion_CI_CD">
    <bpmn:participant id="Part_eq" name="Equipo del módulo CRM" processRef="Process_eq"/>
    <bpmn:participant id="Part_mod" name="Módulos del supergrupo hotelero"/>
    <bpmn:messageFlow id="MsgFlow_02_subproceso_construccion_CI_CD_1" name="Pruebas de contrato" sourceRef="t6" targetRef="Part_mod"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_eq" name="Equipo del módulo CRM" isExecutable="false">
    <bpmn:laneSet id="LaneSet_eq">
      <bpmn:lane id="Lane_dv" name="Desarrollador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ci" name="Plataforma CI/CD (automatizada)">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_qa" name="Tester (QA)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Sprint planificado">
      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Tomar la historia del tablero y crear la rama">
      <bpmn:incoming>Flow_02_subproceso_construccion_CI_CD_1</bpmn:incoming>
      <bpmn:outgoing>Flow_02_subproceso_construccion_CI_CD_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Codificar y escribir pruebas unitarias">
      <bpmn:incoming>Flow_02_subproceso_construccion_CI_CD_2</bpmn:incoming>
      <bpmn:incoming>Flow_02_subproceso_construccion_CI_CD_6</bpmn:incoming>
