<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_04_DNA_reposicion_TO-BE" targetNamespace="http://upao.edu.pe/sii/s12" exporter="bpmn_gen.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_04_DNA_reposicion_TO-BE">
    <bpmn:participant id="Part_cli" name="Supermercado (cliente)"/>
    <bpmn:participant id="Part_dna" name="Distribuidora Nacional de Alimentos" processRef="Process_dna"/>
    <bpmn:participant id="Part_prv" name="Proveedor"/>
    <bpmn:messageFlow id="MsgFlow_04_DNA_reposicion_TO-BE_1" name="Pedido electrónico" sourceRef="Part_cli" targetRef="s"/>
    <bpmn:messageFlow id="MsgFlow_04_DNA_reposicion_TO-BE_2" name="Fecha comprometida" sourceRef="t3" targetRef="Part_cli"/>
    <bpmn:messageFlow id="MsgFlow_04_DNA_reposicion_TO-BE_3" name="Orden de compra electrónica" sourceRef="t4" targetRef="Part_prv"/>
    <bpmn:messageFlow id="MsgFlow_04_DNA_reposicion_TO-BE_4" name="Mercadería y guía" sourceRef="Part_prv" targetRef="t5"/>
    <bpmn:messageFlow id="MsgFlow_04_DNA_reposicion_TO-BE_5" name="Pedido y comprobante" sourceRef="t9" targetRef="Part_cli"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_dna" name="Distribuidora Nacional de Alimentos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_dna">
      <bpmn:lane id="Lane_com" name="Área comercial">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_erp" name="ERP (automatizado)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cmp" name="Compras">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_alm" name="Almacén">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dis" name="Distribución">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Pedido recibido por el portal B2B o EDI">
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_s"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Registrar pedido y validar crédito">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Verificar y reservar stock en tiempo real">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Stock completo?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t3" name="Generar OC sugerida y notificar fecha">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_4</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Aprobar y enviar la orden de compra">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Recibir y registrar la mercadería">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="" gatewayDirection="Converging">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_5</bpmn:incoming>
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Preparar pedido con código de barras">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_9</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t7" name="Despachar pedido y registrar salida">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_10</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t8" name="Planificar la ruta y entregar el pedido">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_11</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t9" name="Registrar la prueba de entrega digital">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_12</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t10" name="Emitir factura electrónica y actualizar KPI">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_13</bpmn:incoming>
      <bpmn:outgoing>Flow_04_DNA_reposicion_TO-BE_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Pedido entregado y facturado">
      <bpmn:incoming>Flow_04_DNA_reposicion_TO-BE_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_1" name="" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_2" name="" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_3" name="" sourceRef="t2" targetRef="g1"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_4" name="No" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_5" name="Sí" sourceRef="g1" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_6" name="" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_7" name="" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_8" name="" sourceRef="t5" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_9" name="" sourceRef="g2" targetRef="t6"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_10" name="" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_11" name="" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_12" name="" sourceRef="t8" targetRef="t9"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_13" name="" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="Flow_04_DNA_reposicion_TO-BE_14" name="" sourceRef="t10" targetRef="e"/>
  </bpmn:process>
